# Server settings
PORT=3000

# Windy Webcams API
WINDY_API_KEY=

# Runtime feed resolution tuning
WINDY_NEARBY_RADIUS_KM=120
WINDY_NEARBY_LIMIT=12
WINDY_RECENT_TTL_MS=900000

# Bulk catalog sync tuning
SYNC_WINDY_RADIUS_KM=250
SYNC_WINDY_LIMIT=50
SYNC_WINDY_MAX_TILES=180
SYNC_WINDY_OFFSETS=0,50,100,150
SYNC_WINDY_DELAY_MS=60

# Optional provider toggles
SYNC_INCLUDE_NYC=true
SYNC_INCLUDE_ONTARIO=true
SYNC_INCLUDE_ALBERTA=true

# Catalog balancing caps
SYNC_MAX_PER_PROVIDER=1200
SYNC_MAX_PER_COUNTRY=180
SYNC_MAX_US=260

# Runtime anti-repeat history across rooms
GLOBAL_RECENT_CAMERA_HISTORY=250
